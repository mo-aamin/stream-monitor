# Copy this file to .env and adjust before running docker compose.
# .env is intentionally ignored by git.

# Web UI port and recording folder are set in docker-compose.yml.
# This app has no built-in login. Restrict access with a firewall, VPN, or
# authenticating reverse proxy if it is reachable by others.

# Container timezone (used for filenames and UI timestamps)
TZ=America/Chicago

# Ownership of ./data and ./recordings on Linux bind mounts.
# On Ubuntu, PUID/PGID should match your login user (usually 1000).
PUID=1000
PGID=1000

# Build options
# Pin yt-dlp to a specific release, e.g. 2025.11.12. Empty = latest at build.
YTDLP_VERSION=
DENO_VERSION=2.9.8
LOG_LEVEL=INFO
